{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "paths": {
      "@fieldnote/tokens": ["../../packages/tokens/src"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
