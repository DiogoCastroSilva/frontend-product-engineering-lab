{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["DOM", "ES2020"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": ["vite/client"]
  },
  "include": [".storybook/**/*.ts", "../../packages/design-system/src/**/*.ts", "../../packages/design-system/src/**/*.tsx"]
}
