{
  "name": "frontend-product-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:fieldnote",
    "dev:fieldnote": "npm run dev --workspace=@fieldnote/fieldnote",
    "dev:storybook": "npm run dev --workspace=@fieldnote/storybook",
    "build": "npm run build:fieldnote",
    "build:fieldnote": "npm run build --workspace=@fieldnote/fieldnote",
    "build:storybook": "npm run build --workspace=@fieldnote/storybook",
    "build:tokens": "npm run build --workspace=@fieldnote/tokens",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
