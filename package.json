{
  "name": "frontend-product-engineering-lab",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:fieldnote",
    "dev:fieldnote": "npm run dev --workspace=@fieldnote/fieldnote",
    "dev:storybook": "npm run dev --workspace=@fieldnote/storybook",
    "build": "npm run build:fieldnote",
    "build:fieldnote": "npm run build --workspace=@fieldnote/fieldnote",
    "build:storybook": "npm run build --workspace=@fieldnote/storybook",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "node scripts/postinstall.cjs",
    "verify": "npm run lint && npm run typecheck && npm run format:check"
  },
  "devDependencies": {
    "@diogozx-org/eslint-config": "^2.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.2",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.71.2"
  }
}
